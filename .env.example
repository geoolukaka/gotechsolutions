# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------
# Which storage backend to use: "mysql" or "google_sheets"
# ---------------------------------------------------------------------
STORAGE_BACKEND=mysql

# Comma-separated list of origins allowed to call this API from the browser.
# Add your GitHub Pages URL and/or custom domain here in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://<your-username>.github.io

# Optional: set this to a random secret string to enable GET /api/submissions
# (pass it back as the X-API-Key header). Leave blank to disable the endpoint.
ADMIN_API_KEY=

# ---------------------------------------------------------------------
# MySQL settings (used when STORAGE_BACKEND=mysql)
# ---------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=gotech_contact

# ---------------------------------------------------------------------
# Google Sheets settings (used when STORAGE_BACKEND=google_sheets)
# ---------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Submissions
